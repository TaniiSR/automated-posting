# Copy to .env and fill in. Never commit .env.
REQUEST_TIMEOUT=20

# Telegraph (optional - an anonymous account is created if empty)
TELEGRAPH_TOKEN=

# Mastodon
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky (use an app password)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Dev.to
DEVTO_API_KEY=

# GitHub Gist (token with the "gist" scope)
GITHUB_TOKEN=

# Pastebin (API dev key from https://pastebin.com/doc_api)
PASTEBIN_API_KEY=
